includes:
    - %rootDir%/../../szepeviktor/phpstan-wordpress/extension.neon
    - tests/baseline/phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - includes
        - modules
        - templates
        - wpmind.php
        - uninstall.php
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - tests (?)
            - node_modules (?)
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
