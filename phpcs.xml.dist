<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="WPMind Coding Standards"
         xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd">

    <description>WPMind 插件代码规范</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>

    <!-- WordPress-Extra 已包含 WordPress-Core，无需重复引用 -->
    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <!-- includes/ 与 modules/ 走 composer PSR-4 自动加载（WPMind\ => includes/），
         文件名必须与类名一致（StudlyCase），与 WPCS 的"连字符小写文件名"规则本质冲突。
         项目已豁免同一意图的 InvalidClassFileName，此处补齐 NotHyphenatedLowercase。 -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>*/includes/*</exclude-pattern>
        <exclude-pattern>*/modules/*</exclude-pattern>
    </rule>

    <rule ref="WordPress-Docs"/>

    <!-- PHP 兼容性检查 -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP">
        <include-pattern>*.php$</include-pattern>
    </rule>

    <!-- 最低 WordPress 版本（用于废弃函数检测） -->
    <config name="minimum_wp_version" value="6.4"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wpmind"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wpmind"/>
                <element value="WPMind"/>
            </property>
        </properties>
    </rule>

    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="s"/>
</ruleset>
